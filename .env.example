# CognoDB Cloud connection (Bolt protocol, Neo4j-compatible driver)
# Create a free instance at https://console.cognodb.com/signup, then copy these from the console.
NEO4J_URI=bolt+s://<instance-id>.databases.cognodb.cloud
NEO4J_USER=cognodb
NEO4J_PASSWORD=<your-generated-password>
NEO4J_DATABASE=neo4j

# Comma-separated list of origins allowed to call the API (add your Vercel URL in production)
ALLOWED_ORIGINS=http://localhost:5173
